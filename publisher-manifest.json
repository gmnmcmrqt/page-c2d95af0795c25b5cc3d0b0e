olor: var(--navy-base);margin-bottom: 10px;position: relative;z-index: 1}\n.step-card p {font-size: 13px;color: var(--text-muted);line-height: 1.6;position: relative;z-index: 1}\n.faq-topics-container {display: grid;grid-template-columns: 1fr 1fr;gap: 28px}\n.faq-group {background: #ffffff;border: 1px solid var(--line-color);border-radius: 8px;padding: 24px}\n.faq-group-title {font-size: 16px;font-weight: 700;color: var(--navy-deep);border-bottom: 2px solid var(--amber-soft);padding-bottom: 8px;margin-bottom: 16px}\n.faq-entry {margin-bottom: 18px}\n.faq-entry:last-child {margin-bottom: 0}\n.faq-question {font-size: 14px;font-weight: 700;color: var(--navy-light);margin-bottom: 6px}\n.faq-answer {font-size: 13px;color: var(--text-muted);line-height: 1.55}\n.clients-board {background: #ffffff;border: 1px solid var(--line-color);border-radius: 8px;padding: 28px}\n.clients-board h3 {font-size: 18px;color: var(--navy-deep);margin-bottom: 12px}\n.clients-board p {font-size: 14px;color: var(--text-muted);margin-bottom: 20px}\n.client-platform-tags {display: flex;flex-wrap: wrap;gap: 10px}\n.platform-pill {border: 1px solid var(--navy-light);color: var(--navy-light);font-size: 12px;font-weight: 600;padding: 6px 14px;border-radius: 20px;background: #f8fafc}\nfooter.site-footer {border-top: 1px solid var(--line-color);background: #ffffff;padding: 24px 20px;text-align: center;font-size: 12px;color: var(--text-muted)}\n@media (max-width: 900px) {\n  .hero-split {grid-template-columns: 1fr;gap: 28px}\n  .plans-staircase {grid-template-columns: 1fr;align-items: stretch}\n  .plan-step-1, .plan-step-2, .plan-step-3 {min-height: auto}\n  .steps-grid {grid-template-columns: 1fr}\n  .faq-topics-container {grid-template-columns: 1fr}\n}\n</style><header class=\"site-header\">\n  <div class=\"crumbs-nav\">\n    <div class=\"crumbs-trail\">\n      <span>稳联云门户</span> / \n      <span>用户中心</span> / \n      <strong>方案与指引</strong>\n    </div>\n    <nav class=\"section-toc\">\n      <a href=\"#plans\">订阅阶梯</a>\n      <a href=\"#clients\">软件支持</a>\n      <a href=\"#guide\">三步接入</a>\n      <a href=\"#faq\">答疑中心</a>\n    </nav>\n  </div>\n</header>\n\n<main>\n  <section class=\"hero-split\">\n    <div class=\"hero-copy\">\n      <span class=\"hero-lead-tag\">网络订阅说明书</span>\n      <h1 class=\"brand-title\">您是否正在寻找清晰可靠的 稳联云 网络接入方案？</h1>\n      <p>面对纷杂的配置参数与套餐规格，用户最关心的往往只有三件事：哪个档位能满足我的设备数？客户端如何同步配置？遇到连接受阻时该如何排查？</p>\n      <p>本文为您提供客观、无附加夸饰的稳联云服务索引。您可以直观比对各阶段流量限额与并发授权，理清日常运维的基本脉络。</p>\n      <div class=\"hero-dialogue-prompt\">\n        <p><strong>初次来访？</strong> 我们建议您先通读下方的“三步接入”流程，再依据常用设备数量核定相应的订阅方案。</p>\n      </div>\n    </div>\n    <div class=\"hero-status-panel\">\n      <div class=\"panel-header\">\n        <h2><span class=\"panel-status-indicator\"></span> 稳联云 接入看板摘要</h2>\n      </div>\n      <div class=\"panel-body\">\n        <dl>\n          <dt>服务架构</dt>\n          <dd>公用分布式中继网络</dd>\n          <dt>计费周期</dt>\n          <dd>支持按月周期结算或年付折扣</dd>\n          <dt>客户端协议</dt>\n          <dd>通用主流订阅格式分发</dd>\n          <dt>设备并发</dt>\n          <dd>依订阅级别提供 3 至 20 台上限</dd>\n          <dt>工单响应</dt>\n          <dd>依照套餐优先级排队处理</dd>\n        </dl>\n      </div>\n      <div class=\"panel-footer\">\n        准备好开始了吗？选择对应业务段落继续查阅。\n        <a href=\"#plans\" class=\"panel-action-btn\">查看资费递进表</a>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"plans\" class=\"section-wrapper\">\n    <div class=\"section-headline\">\n      <h2>问：不同的业务负荷，如何选择对应的稳联云订阅？</h2>\n      <p>答：我们按设备并发需求与每月吞吐流量，为您整理了三个递进阶梯。阶梯式布局让权限差异一目了然。</p>\n    </div>\n    <div class=\"plans-staircase\">\n      <article class=\"plan-step plan-step-1\">\n        <span class=\"card-number-bg\">01</span>\n        <h3 class=\"plan-title\">基础版</h3>\n        <p class=\"plan-query\">轻度浏览、偶尔查阅资料？</p>\n        <div class=\"plan-pricing\">\n          <div class=\"plan-price-main\">¥15<small>/月</small></div>\n          <div class=\"plan-price-sub\">按年付仅需 ¥150/年</div>\n        </div>\n        <ul class=\"plan-features-list\">\n          <li>每月 100GB 极速流量</li>\n          <li>支持 3 台设备同时在线</li>\n          <li>解锁基础流媒体</li>\n          <li>普通线路节点池</li>\n        </ul>\n        <a href=\"#\" class=\"plan-select-link\">选择基础规格</a>\n      </article>\n\n      <article class=\"plan-step plan-step-2\">\n        <span class=\"card-number-bg\">02</span>\n        <span class=\"plan-badge\">主流推选</span>\n        <h3 class=\"plan-title\">旗舰版</h3>\n        <p class=\"plan-query\">多设备主力使用、对响应有要求？</p>\n        <div class=\"plan-pricing\">\n          <div class=\"plan-price-main\">¥35<small>/月</small></div>\n          <div class=\"plan-price-sub\">按年付仅需 ¥350/年</div>\n        </div>\n        <ul class=\"plan-features-list\">\n          <li>每月 300GB 极速流量</li>\n          <li>支持 5 台设备同时在线</li>\n          <li>全节点原生流媒体解锁</li>\n          <li>IPLC 专线游戏加速优化</li>\n          <li>7x24 优先工单支持</li>\n        </ul>\n        <a href=\"#\" class=\"plan-select-link\">开通旗舰方案</a>\n      </article>\n\n      <article class=\"plan-step plan-step-3\">\n        <span class=\"card-number-bg\">03</span>\n        <h3 class=\"plan-title\">团队版</h3>\n        <p class=\"plan-query\">工作室协作、大带宽与定制调度？</p>\n        <div class=\"plan-pricing\">\n          <div class=\"plan-price-main\">¥85<small>/月</small></div>\n          <div class=\"plan-price-sub\">按年付仅需 ¥850/年</div>\n        </div>\n        <ul class=\"plan-features-list\">\n          <li>每月 1000GB 极速流量</li>\n          <li>支持 20 台设备同时在线</li>\n          <li>VIP 专属高带宽节点</li>\n          <li>支持企业定制路由</li>\n          <li>专属客户经理服务</li>\n        </ul>\n        <a href=\"#\" class=\"plan-select-link\">咨询团队部署</a>\n      </article>\n    </div>\n  </section>\n\n  <section id=\"clients\" class=\"section-wrapper\">\n    <div class=\"section-headline\">\n      <h2>问：稳联云 是否需要安装特定专有软件？</h2>\n      <p>答：不需要捆绑专有套件。稳联云遵循通用订阅规范，支持业界标准协议内核。</p>\n    </div>\n    <div class=\"clients-board\">\n      <h3>平台兼容性与工具支持</h3>\n      <p>稳联云不随附非官方定制安装包以确保纯净与安全。用户可通过自身习惯的第三方通用客户端，经由订阅链接（URL）完成接入。本平台不提供未经验证的二进制可执行文件下载。</p>\n      <div class=\"client-platform-tags\">\n        <span class=\"platform-pill\">Windows 环境通用工具</span>\n        <span class=\"platform-pill\">macOS 架构客户端</span>\n        <span class=\"platform-pill\">iOS / iPadOS 订阅解析器</span>\n        <span class=\"platform-pill\">Android 开源核心工具</span>\n        <span class=\"platform-pill\">Linux 终端守护进程</span>\n      </div>\n    </div>\n  </section>\n\n  <section id=\"guide\" class=\"section-wrapper\">\n    <div class=\"section-headline\">\n      <h2>问：从获取订阅到建立连接，共分几步？</h2>\n      <p>答：仅需三步标准操作，即可在本地客户端载入 稳联云 节点配置。</p>\n    </div>\n    <div class=\"steps-grid\">\n      <article class=\"step-card\">\n        <span class=\"card-number-bg\">01</span>\n        <h3>获取专属订阅链接</h3>\n        <p>在稳联云控制台确认订购状态有效后，复制属于您账户的专属 API / 订阅配置地址，注意切勿泄露给第三方。</p>\n      </article>\n      <article class=\"step-card\">\n        <span class=\"card-number-bg\">02</span>\n        <h3>写入第三方客户端</h3>\n        <p>打开本地兼容工具，新建订阅源并粘贴链接，执行同步更新。系统将自动拉取最新的节点地址列表及证书策略。</p>\n      </article>\n      <article class=\"step-card\">\n        <span class=\"card-number-bg\">03</span>\n        <h3>选择出站规则并联机</h3>\n        <p>根据您的网络需求设定路由模式（如分流规则或全局模式），选中延迟与可用性匹配的线路节点，启用代理服务。</p>\n      </article>\n    </div>\n  </section>\n\n  <section id=\"faq\" class=\"section-wrapper\">\n    <div class=\"section-headline\">\n      <h2>常见问题：按主题分类解答</h2>\n      <p>梳理了与 稳联云 相关的订阅、账单与技术问题，供您对照排查。</p>\n    </div>\n    <div class=\"faq-topics-container\">\n      <div class=\"faq-group\">\n        <h3 class=\"faq-group-title\">账户与计费相关</h3>\n        <div class=\"faq-entry\">\n          <h4 class=\"faq-question\">问：按月付和年付在权益上有何差别？</h4>\n          <p class=\"faq-answer\">答：套餐所包含的节点范围、流量限额与设备上限完全一致，年付形式直接享受对应的折价优惠（相当于减免部分月费）。</p>\n        </div>\n        <div class=\"faq-entry\">\n          <h4 class=\"faq-question\">问：设备数上限是如何计算的？</h4>\n          <p class=\"faq-answer\">答：设备数是指同一时刻通过 稳联云 节点建立连接的独立终端数量。例如基础版允许 3 台设备同时活跃连接。</p>\n        </div>\n        <div class=\"faq-entry\">\n          <h4 class=\"faq-question\">问：流量用尽后连接会中断吗？</h4>\n          <p class=\"faq-answer\">答：当月配额耗尽后，节点中继将暂停转发请求，直到下一个账单周期重置，或通过控制台增购临时流量数据包。</p>\n        </div>\n      </div>\n\n      <div class=\"faq-group\">\n        <h3 class=\"faq-group-title\">连接与网络排查</h3>\n        <div class=\"faq-entry\">\n          <h4 class=\"faq-question\">问：提示“订阅更新失败”通常是什么原因？</h4>\n          <p class=\"faq-answer\">答：请检查当前本地网络是否可正常解析域名，或者确认复制的订阅 URL 是否完整无空客字符。若持续异常，可在控制台重新生成令牌。</p>\n        </div>\n        <div class=\"faq-entry\">\n          <h4 class=\"faq-question\">问：为什么某些网页仍显示未代理状态？</h4>\n          <p class=\"faq-answer\">答：请核对客户端内部的分流策略。部分分流规则默认对大陆境内域名做直连放行，如需强制代理，需将该域加入自定义走代理名单或临时切换全局模式。</p>\n        </div>\n        <div class=\"faq-entry\">\n          <h4 class=\"faq-question\">问：旗舰版的专线优化适合哪些场景？</h4>\n          <p class=\"faq-answer\">答：旗舰版及以上提供的专线中继优先保障跨境低抖动与低丢包率，主要服务于跨服联机游戏以及高清流媒体的高码率缓冲。</p>\n        </div>\n      </div>\n    </div>\n  </section>\n</main>\n\n<footer class=\"site-footer\">\n  <p>© 稳联云 基础网络方案说明文档平台. 版权所有。</p>\n</footer>",
